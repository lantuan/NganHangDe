+@router.post("/api/chat/luu-de-truc-tiep")
+async def luu_de_truc_tiep_endpoint(request: Request, payload: LuuDeTrucTiepRequest):
+    """
+    Luu lai vao chat_history 1 luot tao de KHONG di qua CHV_Fun/n8n (nut
+    "Dong y, tao de" o luong xac nhan cau truc, hoac form chon nhanh tao
+    de) - de khong bi "bien mat" khoi hoi thoai khi quay lai qua ?cid=.
+
+    Luu y: file PDF trong luong nay la blob tai truc tiep tren trinh
+    duyet (khong qua DOWNLOAD_DIR nhu luong n8n), nen KHONG co URL server
+    on dinh de luu lai duong_dan_file - luu nhu tin nhan van ban thuong
+    (loai_phan_hoi mac dinh). Khi quay lai hoi thoai se thay lai noi
+    dung da trao doi, nhung khong co lai nut tai file cu (hoc sinh can
+    tao lai neu muon file). Xem 16_CHANGELOG Version 2.28.
+    """
+    user = get_current_user(request)
+    if user is None:
+        raise HTTPException(401, "Bạn chưa đăng nhập hoặc phiên đã hết hạn.")
+
+    history_service.luu_tin_nhan(
+        user_id=user.id,
+        conversation_id=payload.conversation_id,
+        role="user",
+        noi_dung=payload.user_message,
+    )
+    history_service.luu_tin_nhan(
+        user_id=user.id,
+        conversation_id=payload.conversation_id,
+        role="assistant",
+        noi_dung=payload.ai_caption,
+    )
+    return {"success": True}
