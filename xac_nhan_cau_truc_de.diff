+@router.get("/de-gan-nhat")
+def de_gan_nhat_endpoint(conversation_id: str):
+    """
+    Tra ve de_id cua de MOI NHAT da tao trong 1 cuoc hoi thoai. Dung cho
+    chat.html khi goi THANG /generate-pdf-auto (khong qua n8n - luong
+    "xac nhan cau truc de", xem 16_CHANGELOG Version 2.24) de lay duoc
+    de_id hien nut Co/Khong lam bai truc tiep, giong het luong binh
+    thuong dang di qua n8n (o do de_id lay tu history_service sau khi
+    n8n da goi generate-pdf-auto va luu lich su roi).
+    """
+    de = history_service.lay_de_gan_nhat(conversation_id)
+    if de is None or not de.get("id"):
+        raise HTTPException(404, "Chua co de nao duoc tao trong cuoc hoi thoai nay.")
+    return {"success": True, "de_id": de["id"]}
