+// Xay HTML bang tom tat ket qua (diem tung cau: dung/sai/diem dat
+// duoc) - dung y het cau truc thong tin cua veKetQua() o tren nhung
+// gon hon, phu hop hien trong 1 bubble chat. Dung the <div>/<strong>
+// thay vi CSS class rieng (vi chat.html khong co san cac class .ket-
+// qua/.cau-hoi/.dung/.sai cua trang lam-bai) de hien thi dung ngay ca
+// khi khong co CSS phu tro.
+function xayHtmlTomTatKetQua(ketQua) {
+    let html = '<p><strong>📊 Kết quả: ' + ketQua.diem_tren_10_tam_tinh +
+        '/10 điểm</strong>' +
+        (ketQua.ghi_chu ? ' <span style="color:#64748b;font-size:13px;">(' + ketQua.ghi_chu + ')</span>' : '') +
+        '</p>';
+    html += '<div style="display:flex;flex-direction:column;gap:4px;margin-top:4px;font-size:14px;">';
+    (ketQua.chi_tiet || []).forEach(function (cau) {
+        let dong = '<strong>Câu ' + cau.so_thu_tu + (cau.loai_cau ? ' (' + cau.loai_cau + ')' : '') + ':</strong> ';
+        if (cau.loai_cau === 'TF') {
+            dong += (cau.so_y_dung === 4 ? '✅' : '⚠️') +
+                ' đúng ' + cau.so_y_dung + '/4 ý (' + cau.diem_dat_duoc + ' điểm)';
+            if (cau.chi_tiet_tung_y && typeof cau.chi_tiet_tung_y === 'object') {
+                const yStr = Object.keys(cau.chi_tiet_tung_y).sort().map(function (y) {
+                    return (cau.chi_tiet_tung_y[y] ? '✅' : '❌') + y.toUpperCase();
+                }).join(' ');
+                dong += ' — ' + yStr;
+            }
+        } else if (cau.dung_sai_hoac_diem === true) {
+            dong += '✅ Đúng (' + (cau.diem_toi_da || 0) + ' điểm)';
+        } else if (cau.dung_sai_hoac_diem === false) {
+            dong += '❌ Sai — đáp án đúng: ' + (cau.dap_an_dung || '');
+        } else if (typeof cau.dung_sai_hoac_diem === 'number') {
+            dong += '📝 ' + cau.dung_sai_hoac_diem + '/' + (cau.diem_toi_da || 0) + ' điểm' +
+                (cau.nhan_xet ? ' — ' + cau.nhan_xet : '');
+        } else {
+            dong += '⏳ ' + (cau.nhan_xet || 'Chưa chấm được tự động.');
+        }
+        html += '<div>' + dong + '</div>';
+    });
+    html += '</div>';
+    return html;
+}
