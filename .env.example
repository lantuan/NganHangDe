# MAU .env - chi co TEN BIEN, KHONG co gia tri that. Cac khoa that nam trong
# ban sao luu rieng (~/NganHangDe_SaoLuu/moi_nhat/env), KHONG len GitHub.
# Copy thanh .env roi dien gia tri:   cp .env.example .env

# --- Supabase (bat buoc) ---
SUPABASE_URL=
SUPABASE_KEY=
# Khoa service_role: neu thieu app chay bang khoa anon va in canh bao (xem docs/22_BAO_MAT_RLS.md)
SUPABASE_SERVICE_KEY=

# --- Google Classroom (OAuth Client RIENG, khac client dang nhap Google) ---
GOOGLE_CLASSROOM_CLIENT_ID=
GOOGLE_CLASSROOM_CLIENT_SECRET=

# --- Ma moi dang ky tai khoan giao vien ---
MA_MOI_GIAO_VIEN=

# --- Webhook n8n ---
N8N_WEBHOOK_CHAM_TU_LUAN=
N8N_WEBHOOK_DOC_PHIEU=
N8N_WEBHOOK_GIA_SU=
