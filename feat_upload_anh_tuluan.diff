+// Gop ket qua /grade (MC/TF/SA) va /grade-photo (TL qua CHV_Grader).
+// Tinh lai diem tren 10 tu dau dua tren TOAN BO cau da cham duoc o CA
+// HAI nguon - khong dung thang diem_tren_10_tam_tinh rieng cua tung ben
+// (moi ben tu chuan hoa /10 tren tap con rieng cua no nen khong cong
+// truc tiep duoc).
+function gopKetQua(ketQuaChinh, ketQuaAnh) {
+    const theoStt = {};
+    (ketQuaChinh.chi_tiet || []).forEach(function (c) { theoStt[c.so_thu_tu] = c; });
+    (ketQuaAnh.chi_tiet || []).forEach(function (c) {
+        if (c.dung_sai_hoac_diem !== null && c.dung_sai_hoac_diem !== undefined) {
+            theoStt[c.so_thu_tu] = c;
+        }
+    });
+
+    let diemDat = 0, diemToiDaDaCham = 0;
+    Object.keys(theoStt).forEach(function (stt) {
+        const c = theoStt[stt];
+        const gt = c.dung_sai_hoac_diem;
+        if (gt === null || gt === undefined) return;
+        diemToiDaDaCham += c.diem_toi_da || 0;
+        // Cau TF: dung_sai_hoac_diem chi la true/false (het 4/4 y hay
+        // khong), diem THAT SU (theo ty le so_y_dung/4) nam o
+        // diem_dat_duoc - phai uu tien truong nay truoc, khong duoc coi
+        // TF nhu true/false toan phan/khong diem.
+        if (c.loai_cau === 'TF' && typeof c.diem_dat_duoc === 'number') {
+            diemDat += c.diem_dat_duoc;
+        } else if (typeof gt === 'boolean') {
+            diemDat += gt ? (c.diem_toi_da || 0) : 0;
+        } else if (typeof gt === 'number') {
+            diemDat += gt;
+        }
+    });
+
+    const diemTren10 = diemToiDaDaCham ? Math.round((diemDat / diemToiDaDaCham) * 10 * 100) / 100 : 0;
+
+    return {
+        tong_so_cau: ketQuaChinh.tong_so_cau,
+        diem_tren_10_tam_tinh: diemTren10,
+        ghi_chu: 'Điểm tạm tính trên các câu đã chấm được (MC/TF/SA tự động + tự luận qua CHV_Grader nếu có ảnh). Câu còn lại cần cô/thầy chấm tay.',
+        chi_tiet: Object.keys(theoStt).map(function (k) { return theoStt[k]; }).sort(function (a, b) { return a.so_thu_tu - b.so_thu_tu; })
+    };
+}
